# Локальные настройки для make deploy-prod.
# Скопируйте в vps_conf/deploy.env и заполните данные SSH-доступа.
# Файл deploy.env игнорируется Git.

VPS_HOST=your-vps-host-or-ip
VPS_USER=root
VPS_SSH_PORT=22
VPS_REMOTE_DIR=/opt/learn-service

# Необязательно. По умолчанию используется ~/.ssh/id_ed25519.
# VPS_SSH_KEY=~/.ssh/vps_deploy_key
