# Production env for VPS deploy.
# Copy to vps_conf/.env.prod and fill secrets BEFORE running deploy.
# This file is consumed by docker-compose.vps.prod_bluegreen.yml

ENV=prod
DEBUG=false
LOG_LEVEL=INFO

# ── Application ──────────────────────────────────────────────
URL=https://yourdomain.com
DOMAIN_NAME=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
SECRET_KEY=change-me-strong-password
SECRET=replace-with-generated-secret-minimum-32-characters
ALGORITHM="RS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320
COOKIE_SECURE=true
SERVICE_API_KEY=replace-with-your-service-api-key
AI_SERVICE_API_KEY=replace-with-your-ai-service-api-key
# ── Postgres (in-cluster pgvector) ───────────────────────────
POSTGRES_DB=learn_db
POSTGRES_USER=learn_user
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://learn_user:change-me-strong-password@postgres:5432/learn_db
USER_ADMIN_PASSWORD=change-me-strong-password

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
ARQ_REDIS_URL=redis://redis:6379/0

# ── LiteLLM ──────────────────────────────────────────────────
# master_key — используется как Bearer-токен для API и как пароль /ui (если UI_PASSWORD не задан)
# Формат: sk-<любая строка>
LITELLM_MASTER_KEY=sk-change-me-strong-litellm-key
# Учётные данные для входа в /ui дашборд
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me-strong-ui-password

# ── External services ────────────────────────────────────────
OPENAI_API_KEY=put-in-key-here
ANTHROPIC_API_KEY=put-in-key-here
DEEPSEEK_API_KEY=put-in-key-here
GEMINI_API_KEY=put-in-key-here

# ── SMTP / Email relay (Postfix) ─────────────────────────────
SMTP_RELAYHOST=
SMTP_SASL_PASSWD=

# ── SMTP app settings (Python EmailManager) ──────────────────
SMTP_HOST=smtp
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USERNAME=
SMTP_PASSWORD=
